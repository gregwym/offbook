# Template for .env.prod — the SECRETS file consumed by the prod compose stack
# (docker-compose.prod.yml), selected with FLAVOR=prod.
#
# `make deploy FLAVOR=prod` auto-creates this file from the example and fills
# SESSION_SECRET on first boot — you only need to set FRONTEND_URL by hand. Or
# copy it yourself:  cp .env.prod.example .env.prod
#
# .env.prod is gitignored. It's loaded both as `--env-file` for compose variable
# substitution and as the backend container's env_file (SESSION_SECRET,
# FRONTEND_URL). The prod project name + overlay list come from FLAVOR=prod, not
# from this file.
#
# Deploy with:  command make deploy FLAVOR=prod TS_AUTHKEY=tskey-... TS_HOSTNAME=offbook-prod  (first boot)
#               command make deploy FLAVOR=prod                                                 (updates)
#
# Tailscale IDENTITY (TS_AUTHKEY, TS_HOSTNAME) is NOT stored here — pass it once
# at first boot. Mint a per-instance, tagged (tag:offbook) key at:
#   https://login.tailscale.com/admin/settings/keys
# Optional extra tailscaled flags; leave unset if your auth key auto-applies a
# tag. Set e.g. `--advertise-tags=tag:offbook` only if you mint untagged keys.
# TS_EXTRA_ARGS=

# ─── Backend ──────────────────────────────────────────────────────────────────
# 32-byte hex key. Auto-generated by `make deploy` on first boot; set by hand
# only for non-deploy runs. Generate with: openssl rand -hex 32. Required in prod.
SESSION_SECRET=
# CORS allow-origin. Set to the full tailnet URL. Same-origin via nginx proxy
# in production, so this is belt-and-suspenders; still keep it accurate.
FRONTEND_URL=https://offbook-prod.<your-tailnet>.ts.net

# ─── Plaid (disabled in prod for now — leave unset) ───────────────────────────
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
# PLAID_TOKEN_KEY=
