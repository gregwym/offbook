# User-level templated timer. Enabled per FLAVOR by install.sh, e.g.
#   systemctl --user enable --now offbook-deploy@dev.timer
[Unit]
Description=Poll origin/main and redeploy offbook (%i) every 2 minutes

[Timer]
# First check shortly after boot, then every 2 minutes while the host is up.
OnBootSec=2min
OnUnitActiveSec=2min
AccuracySec=15s
# Catch up with a single run if the host was asleep/off across a tick.
Persistent=true
Unit=offbook-deploy@%i.service

[Install]
WantedBy=timers.target
