# PostgreSQL
DATABASE_URL=postgres://offbook:offbook@localhost:5432/offbook?sslmode=disable

# Backend
PORT=8000
FRONTEND_URL=http://localhost:5173
MIGRATIONS_PATH=migrations

# Auth (required from M2.5+)
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Plaid (optional — get keys at https://dashboard.plaid.com)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# 32-byte hex AES-256 key for encrypting Plaid access_tokens at rest (ADR-0010).
# Required when PLAID_CLIENT_ID is set. Generate with: openssl rand -hex 32
PLAID_TOKEN_KEY=

# AI Providers (optional)
CLAUDE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
